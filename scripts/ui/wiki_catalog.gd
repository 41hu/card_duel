var entries: Array = []
var _notes: Array = []

func _add_section(title: String, body: String):
	if not body.is_empty(): _notes.append({"name": title, "body": body})

func _add_group_label(_text: String):
	pass

func _add_card_block(title: String, lines: Array):
	_notes.append({"name": title, "body": "\n\n".join(lines)})

func _entry(id: String, category: String, title: String, summary: String, body: String, icon: String = ""):
	entries.append({"id": id, "category": category, "name": title, "summary": summary, "body": body, "icon": icon})

func build() -> Array:
	entries.clear()
	var items = Items.new(null)
	for id in Config.CHARACTER_IDS:
		var c = Config.CHARACTER_DB[id]
		var parts: Array[String] = []
		var sections: Array = []
		var item_parts: Array[String] = []
		for skill in CHAR_SKILLS.get(id, []):
			if (id == "vine_ent" and skill[1] in ["缠绕", "神经毒素", "除根（反制）"]) or (id == "miko" and skill[1] == "结界"):
				item_parts.append(skill[2])
				continue
			parts.append("%s · %s\n%s" % [skill[0], skill[1], skill[2]])
			sections.append({"title": "%s · %s" % [skill[0], skill[1]], "body": skill[2], "icon": "res://art/wiki/skills/%s/%s.png" % [id, skill[1]], "kind": "skill"})
		var item_type: String = Skills.item_type_for_character(id)
		if item_type != "trap":
			var data: Dictionary = items.get_item_type(item_type)
			if item_parts.is_empty(): item_parts.append(data.desc)
			var item_body = "道具牌放置「%s」。\n%s" % [data.name, "\n".join(item_parts)]
			parts.append(item_body)
			sections.append({"title": "专属道具 · " + data.name, "body": item_body, "icon": "res://art/wiki/items/%s.png" % item_type, "kind": "item"})
		_entry("char:" + id, "chars", c.name, "生命 %d · 近战 %d · 远程 %d · 魔法 %d" % [c.hp, c.near, c.range, c.magic],
			"\n\n".join(parts) if not parts.is_empty() else c.skill_desc)
		entries[-1]["sections"] = sections
		entries[-1]["portrait"] = "res://art/wiki/portraits/%s.png" % id
	_entry("group:basic", "cards", "普通攻击卡", "分类总览 · 近战 / 远程 / 魔法", "普通攻击卡包括近战、远程和魔法，基础消耗1攻击行动点。角色或武器可能改变实际消耗和效果。\n\n近战用于贴脸攻击，也可用于格挡；远程有距离衰减，也可用于牵制；魔法无视距离，也可用于闪避。")
	_entry("group:enhanced", "cards", "强化攻击卡", "分类总览 · 重击 / 穿心 / 吟唱", "强化攻击卡包括重击、穿心和吟唱，基础消耗2攻击行动点，具有强化伤害和穿甲机制。\n\n重击对应近战，穿心对应远程，吟唱对应魔法。具体使用条件和伤害公式见各卡条目。强化攻击卡本身不能代替普通攻击卡进行格挡、牵制或闪避响应。\n\n强化攻击也可成为技能材料，例如注魔、修复、埋伏、蔓延和魔力引导。")
	_entry("group:movement", "cards", "位移效果", "机制总览 · 移动 / 威慑 / 吸引", "移动卡使自己位移；贴脸时可推人。威慑将目标推远，吸引将目标拉近，目标位置、棋盘边界与占位会影响能否执行。\n\n暗影步、风神弓等技能或装备也可能造成位移，具体条件见相应条目。\n\n位移可能触发地格道具，以及致残伤害。树妖位移后会检查生根。是否消耗位移行动点取决于发起位移的卡牌或技能，并非所有位移都消耗位移行动点。")
	_notes.clear()
	_fill_cards()
	for note in _notes:
		if note.name in ["响应系统", "攻击卡与伤害计算"]:
			_entry("rules:" + note.name, "rules", note.name, "战斗规则", note.body)
	var aliases = {"heal_3": "回复+3", "heal_5": "回复+3", "near_buf": "数值强化", "range_buf": "数值强化", "magic_buf": "数值强化"}
	for id in Config.CARD_DB:
		var c = Config.CARD_DB[id]
		var body: String = c.desc
		for note in _notes:
			if note.name.begins_with(aliases.get(id, c.name) + "（") or note.name.begins_with(aliases.get(id, c.name) + " /"):
				body = note.body
				break
		if id.ends_with("_weapon"): body = "从卡组的对应武器幻化池中随机幻化一把武器，选择装备或丢弃。具体武器效果可在装备分类中查看。"
		if id.ends_with("_armor"): body = "装备对应类型防具。角色技能可能改变耐久或将装备行为替换为修复活铠。"
		if id == "item": body = "道具由角色决定：通常为陷阱，猎人为捕兽夹，巫女为鸟居，树妖为蔓生种子。\n\n树妖的道具卡只给已有种子叠层，最多2层；新种子由生根或蔓延生成。"
		var limits: Array[String] = []
		for package in Deck.HEAL_PACKAGES:
			if id in ["heal_3", "heal_5"]:
				limits.append("%s：固定%d张" % [package, Deck.HEAL_PACKAGES[package].heal.get(id, 0)])
			else:
				limits.append("%s：最多%d张" % [package, Deck.card_limit(id, package)])
		body += "\n\n构筑上限（回复套餐）\n" + " · ".join(limits)
		var family := "普通攻击卡" if id in ["near", "range", "magic"] else ("强化攻击卡" if id in ["heavy", "pierce", "chant"] else ("位移效果" if id in ["move", "attract", "deter"] else ""))
		if not family.is_empty(): body += "\n\n所属分类：" + family
		_entry("card:" + id, "cards", c.name, (family + " · " if not family.is_empty() else "") + "%s · 消耗%d" % [["免费", "攻击行动点", "位移行动点", "功能行动点"][c.ap], c.cost], body,
			"res://art/ui/ap_%s.svg" % ["free", "attack", "move", "function"][c.ap])
	for id in Config.WEAPON_DB:
		var e = Config.WEAPON_DB[id]
		_entry("weapon:" + id, "equipment", e.name, {"near": "近战武器", "range": "远程武器", "magic": "法术武器"}.get(e.type, "武器"), e.desc)
	for id in Config.ARMOR_DB:
		var e = Config.ARMOR_DB[id]
		_entry("armor:" + id, "equipment", e.name, "防具", e.desc)
	for id in Info._STATUS_ICONS:
		var name: String = Info._STATUS_ICONS[id].name
		var sources: Array[String] = []
		for char_id in CHAR_SKILLS:
			for skill in CHAR_SKILLS[char_id]:
				if name in str(skill[1]) or name in str(skill[2]):
					sources.append("%s · %s\n%s" % [Config.char_name(char_id), skill[1], skill[2]])
		for weapon_id in Config.WEAPON_DB:
			var weapon = Config.WEAPON_DB[weapon_id]
			if name in str(weapon.desc): sources.append("%s\n%s" % [weapon.name, weapon.desc])
		for card_id in Config.CARD_DB:
			var card = Config.CARD_DB[card_id]
			if name == card.name: sources.append("%s\n%s" % [card.name, card.desc])
		if not sources.is_empty(): _entry("status:" + id, "status", name, "状态与来源", "\n\n".join(sources))
	var pools: Array[String] = []
	var names = {"attack": "攻击池", "tactics": "战术池", "sustain": "回复数值池", "equipment": "装备池"}
	for key in Deck.CATEGORY_LIMITS: pools.append("%s：最多%d张" % [names[key], Deck.CATEGORY_LIMITS[key].max])
	for key in Deck.SUB_LIMITS: pools.append("%s子上限：最多%d张" % [key, Deck.SUB_LIMITS[key].max])
	for key in Deck.HEAL_PACKAGES: pools.append("%s：%s" % [key, Deck.HEAL_PACKAGES[key].desc])
	_entry("rules:deck", "rules", "自定义卡组构筑", "%d张卡组 · 四池上限 · 回复套餐" % Deck.DECK_SIZE,
		"卡组总张数：%d。各池是上限，并非必须填满的配额。\n\n%s\n\n武器幻化池：每种类型选择%d把不同武器。" % [Deck.DECK_SIZE, "\n\n".join(pools), Deck.WEAPON_POOL_SIZE])
	_notes.clear()
	_fill_rules()
	_fill_mechs()
	for note in _notes:
		_entry("rules:" + note.name, "rules", note.name, note.body.get_slice("\n", 0), note.body)
	return entries

func _fill_rules():
	_add_section("游戏玩法",
		"《卡牌对决》是一款回合制战术卡牌对战游戏。双人局在一条 11 格横线棋盘上，双方各操控一名角色，通过出牌、移动与响应博弈，率先将对方 HP 清空、并使其无法复活的一方获胜；多人混战支持 4 名角色在六边形棋盘上混战，最后存活者胜。未来将制作更复杂的棋盘地图，向 CCG+SRPG+DBG 形式前进。")
	_add_section("棋盘与位置",
		"双人棋盘为11格横线，玩家初始位于坐标3和7。战斗距离为坐标差的绝对值减1，最低为0；相邻两格即贴脸。\n角色可在格子上移动；贴脸时向对方方向移动，可推着对方一起移动。")
	_add_section("游戏模式",
